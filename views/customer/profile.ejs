<div class="page-header" style="background-color: var(--color-primary); padding: 3rem 0; color: white;">
    <div class="container">
        <h1 style="color: white; margin-bottom: 0.5rem;"><%= title %></h1>
    </div>
</div>

<section class="section" style="background-color: var(--color-background);">
    <div class="container">
        <div style="display: grid; grid-template-columns: 250px 1fr; gap: 3rem;">
            <!-- Customer Sidebar -->
            <aside>
                <div class="card" style="padding: 1.5rem;">
                    <ul style="list-style: none;">
                        <li style="margin-bottom: 0.5rem;">
                            <a href="/account" class="btn btn-text" style="width: 100%; justify-content: flex-start; <%= currentPath === '/account' ? 'color: var(--color-accent); font-weight: bold;' : '' %>">
                                <i data-lucide="layout-dashboard"></i> Dashboard
                            </a>
                        </li>
                        <li style="margin-bottom: 0.5rem;">
                            <a href="/account/bookings" class="btn btn-text" style="width: 100%; justify-content: flex-start; <%= currentPath === '/account/bookings' ? 'color: var(--color-accent); font-weight: bold;' : '' %>">
                                <i data-lucide="calendar"></i> My Bookings
                            </a>
                        </li>
                        <li style="margin-bottom: 0.5rem;">
                            <a href="/account/profile" class="btn btn-text" style="width: 100%; justify-content: flex-start; <%= currentPath === '/account/profile' ? 'color: var(--color-accent); font-weight: bold;' : '' %>">
                                <i data-lucide="user"></i> Profile Settings
                            </a>
                        </li>
                    </ul>
                </div>
            </aside>
            
            <!-- Profile Content -->
            <div>
                <div class="card" style="padding: 2rem;">
                    <h3 style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1rem;">Profile Settings</h3>
                    <form action="/api/customer/profile" method="POST" class="needs-validation" novalidate>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                            <div>
                                <label for="first_name" style="display: block; font-weight: 500; margin-bottom: 0.5rem; font-size: 0.9rem;">First Name</label>
                                <input type="text" id="first_name" name="first_name" value="<%= currentUser.firstName %>" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-family: inherit;">
                            </div>
                            <div>
                                <label for="last_name" style="display: block; font-weight: 500; margin-bottom: 0.5rem; font-size: 0.9rem;">Last Name</label>
                                <input type="text" id="last_name" name="last_name" value="<%= currentUser.lastName %>" required style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-family: inherit;">
                            </div>
                        </div>
                        <div style="margin-bottom: 1.5rem;">
                            <label for="email" style="display: block; font-weight: 500; margin-bottom: 0.5rem; font-size: 0.9rem;">Email Address</label>
                            <input type="email" id="email" name="email" value="<%= currentUser.email %>" readonly style="width: 100%; padding: 0.75rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); font-family: inherit; background-color: var(--color-background);">
                            <small style="color: var(--color-text-muted);">Email cannot be changed</small>
                        </div>
                        <button type="submit" class="btn btn-primary">Save Changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
