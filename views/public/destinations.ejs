<div class="page-header" style="background-color: var(--color-primary); padding: 4rem 0; color: white; text-align: center;">
    <div class="container">
        <h1 style="color: white; margin-bottom: 0.5rem;"><%= title %></h1>
        <p style="color: rgba(255,255,255,0.8); max-width: 600px; margin: 0 auto;">
            Discover the most breathtaking places across the Pearl of Africa.
        </p>
    </div>
</div>

<section class="section">
    <div class="container">
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
            <!-- Placeholder destination card -->
            <a href="/destinations/demo" class="card" style="display: block; position: relative; overflow: hidden; height: 300px;">
                <div style="position: absolute; inset: 0; background-color: var(--color-primary-light);"></div>
                <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,41,32,0.9), transparent); z-index: 1;"></div>
                <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.5rem; z-index: 2; color: white;">
                    <h3 style="color: white; margin-bottom: 0.25rem;">Kampala</h3>
                    <p style="color: rgba(255,255,255,0.8); font-size: 0.9rem; margin-bottom: 0;">Central Uganda</p>
                </div>
            </a>
            
            <a href="/destinations/demo" class="card" style="display: block; position: relative; overflow: hidden; height: 300px;">
                <div style="position: absolute; inset: 0; background-color: var(--color-accent);"></div>
                <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(15,41,32,0.9), transparent); z-index: 1;"></div>
                <div style="position: absolute; bottom: 0; left: 0; right: 0; padding: 1.5rem; z-index: 2; color: white;">
                    <h3 style="color: white; margin-bottom: 0.25rem;">Bwindi Impenetrable Forest</h3>
                    <p style="color: rgba(255,255,255,0.8); font-size: 0.9rem; margin-bottom: 0;">Southwestern Uganda</p>
                </div>
            </a>
        </div>
    </div>
</section>
