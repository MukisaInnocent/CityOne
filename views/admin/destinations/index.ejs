<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h2 style="margin: 0;"><%= title %></h2>
    <a href="/admin/destinations/new" class="btn btn-primary"><i data-lucide="plus"></i> Add Destination</a>
</div>

<div class="card" style="padding: 1.5rem;">
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Country</th>
                    <th>Region</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="5" style="text-align: center; color: var(--color-text-muted); padding: 2rem;">No destinations found. Create your first destination.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
