<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
    <h2 style="margin: 0;"><%= title %></h2>
</div>

<div class="card" style="padding: 1.5rem;">
    <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
        <input type="text" placeholder="Search by ref or customer..." style="padding: 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); width: 300px;">
        <select style="padding: 0.5rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm);">
            <option value="">All Statuses</option>
            <option value="pending">Pending</option>
            <option value="confirmed">Confirmed</option>
            <option value="cancelled">Cancelled</option>
        </select>
    </div>
    
    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Ref</th>
                    <th>Customer</th>
                    <th>Tour</th>
                    <th>Travel Date</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="7" style="text-align: center; color: var(--color-text-muted); padding: 2rem;">No bookings found.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
