<footer class="site-footer">
    <div class="container footer-grid">
        <div class="footer-about">
            <img src="/images/logo.png" alt="<%= site.name %> Logo" class="footer-logo">
            <p><%= site.tagline %></p>
            <div class="social-links">
                <% if (site.facebook) { %><a href="<%= site.facebook %>" target="_blank" rel="noopener"><i data-lucide="facebook"></i></a><% } %>
                <% if (site.instagram) { %><a href="<%= site.instagram %>" target="_blank" rel="noopener"><i data-lucide="instagram"></i></a><% } %>
                <% if (site.twitter) { %><a href="<%= site.twitter %>" target="_blank" rel="noopener"><i data-lucide="twitter"></i></a><% } %>
                <% if (site.youtube) { %><a href="<%= site.youtube %>" target="_blank" rel="noopener"><i data-lucide="youtube"></i></a><% } %>
            </div>
        </div>
        
        <div class="footer-links">
            <h3>Quick Links</h3>
            <ul>
                <li><a href="/tours">All Tours</a></li>
                <li><a href="/destinations">Destinations</a></li>
                <li><a href="/about">About Us</a></li>
                <li><a href="/contact">Contact</a></li>
            </ul>
        </div>
        
        <div class="footer-links">
            <h3>Support</h3>
            <ul>
                <li><a href="/faq">FAQ</a></li>
                <li><a href="/terms">Terms & Conditions</a></li>
                <li><a href="/privacy">Privacy Policy</a></li>
            </ul>
        </div>
        
        <div class="footer-contact">
            <h3>Contact Us</h3>
            <p><i data-lucide="map-pin"></i> <%= site.address %>, <%= site.city %></p>
            <p><i data-lucide="phone"></i> <a href="tel:<%= site.phone %>"><%= site.phone %></a></p>
            <p><i data-lucide="mail"></i> <a href="mailto:<%= site.email %>"><%= site.email %></a></p>
            <% if (site.whatsapp) { %>
            <p><i data-lucide="message-circle"></i> <a href="https://wa.me/<%= site.whatsapp.replace(/[^0-9]/g, '') %>" target="_blank">WhatsApp Us</a></p>
            <% } %>
        </div>
    </div>
    <div class="footer-bottom">
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> <%= site.name %>. All rights reserved.</p>
        </div>
    </div>
</footer>
