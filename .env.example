# Environment Configuration for City One Adventures
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=City One Adventures
APP_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cityone_adventures

# JWT Authentication
JWT_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Session
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_64_CHAR_STRING

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=City One Adventures <info@cityoneadventure.com>

# Payment Gateway - Flutterwave (https://flutterwave.com)
FLW_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxx
FLW_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxx
FLW_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
FLW_WEBHOOK_SECRET=your-webhook-secret
PAYMENT_MODE=sandbox

# Currency Exchange API (https://exchangerate-api.com)
EXCHANGE_RATE_API_KEY=your-api-key
EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6

# Google Analytics (optional)
GA_MEASUREMENT_ID=

# File Uploads
MAX_FILE_SIZE=5242880
UPLOAD_DIR=public/uploads

# Logging
LOG_LEVEL=info
LOG_DIR=logs
