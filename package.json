{
  "name": "cityone-adventures",
  "version": "1.0.0",
  "description": "City One Adventures — Worldwide Tour & Travel Management System",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "migrate": "npx knex migrate:latest",
    "migrate:rollback": "npx knex migrate:rollback",
    "seed": "npx knex seed:run",
    "db:setup": "npx knex migrate:latest && npx knex seed:run",
    "db:reset": "npx knex migrate:rollback --all && npx knex migrate:latest && npx knex seed:run"
  },
  "keywords": [
    "travel",
    "tourism",
    "tours",
    "safaris",
    "booking",
    "uganda"
  ],
  "author": "City One Adventures",
  "license": "PROPRIETARY",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csrf-csrf": "^3.0.6",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nodemailer": "^6.9.15",
    "sharp": "^0.33.5",
    "slugify": "^1.6.6",
    "uuid": "^10.0.0",
    "winston": "^3.14.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
